# Only disposable LOCAL QA values. Do not copy the Lightsail .env here.
# Fill in every blank value. The other entries provide defaults for local QA.
POSTGRES_DB=m2_qa
POSTGRES_USER=m2_qa
POSTGRES_PASSWORD=
# Generate 32 random bytes as Base64, once per local environment (README).
TRACKING_CODE_ENCRYPTION_KEY_BASE64=
TRACKING_CODE_ENCRYPTION_KEY_ID=qa-v1
# Private passwords chosen locally; no default or real M1 account is used.
MOCK_CITIZEN_PASSWORD=
MOCK_AGENT_PASSWORD=
MOCK_AREA_RESPONSIBLE_PASSWORD=
MOCK_ADMIN_PASSWORD=
QA_RABBIT_USER=m2_qa
QA_RABBIT_PASSWORD=
# Protects the local truststore containing only the generated public CA.
QA_TRUSTSTORE_PASSWORD=
# All published ports bind exclusively to loopback.
QA_FRONTEND_PORT=18081
QA_BACKEND_PORT=18080
QA_CORE_PORT=18090
